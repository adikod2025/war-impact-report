# Copy this file to `.env` (same folder) and fill in what you need.
# Everything here is optional — Thinkforge runs fully without any of it.

# Turns on AI marking, the Socratic coach and growth narratives.
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Which model to use. Default: claude-opus-5
# THINKFORGE_MODEL=claude-opus-5

# Port for the web app. Default: 4173
# PORT=4173

# Network binding. Default: 127.0.0.1 (this machine only).
# Set to 0.0.0.0 to let other devices on your network reach it — only do this
# on a trusted network, because it holds children's work.
# HOST=0.0.0.0

# Where the database file lives. Default: ./data/thinkforge.db
# THINKFORGE_DB=./data/thinkforge.db
