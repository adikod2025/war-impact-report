{
  "name": "thinkforge",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "A web platform that teaches thinking skills to 9-15 year-olds, with AI scoring, tutoring and evolution tracking.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.mjs",
    "dev": "node --no-warnings --watch server/index.mjs",
    "test": "node --no-warnings --test 'tests/**/*.test.mjs'",
    "seed": "node --no-warnings scripts/seed.mjs",
    "doctor": "node --no-warnings scripts/doctor.mjs",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "selftest": "node --no-warnings scripts/selftest.mjs",
    "go": "node --no-warnings scripts/run.mjs"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  },
  "license": "MIT"
}
